# Copy to .env. Never commit .env.
ADMIN_TOKEN=change-me                # required for approve/reject/mode/chaos endpoints
MODE=AUTO_GATED                      # AUTO_GATED | MANUAL
SIMULATION_SPEED=2                   # simulator ticks per wall-clock second
DECIDE_EVERY_TICKS=4
HORIZON_TICKS=40
EVAL_TICKS=16
COVER_TICKS=32
GATE_MIN_CONFIDENCE=0.6
GATE_MAX_DEPOT_SHARE=0.5
ROUTER_PRIMARY=laya                  # laya | jev | rules (switchable at runtime: PUT /api/router)
LAYA_MODEL=typed-decisions           # english | multilingual | typed-decisions
ROUTER_SHADOW=1                      # also ask the non-primary model, for Laya-vs-Jev comparison
ROUTER_TIMEOUT_S=2.0
JEV_API_KEY=                  # set to enable Jev (typesafe/jev-1.13)
# Phase 6 (not used yet)
GROQ_API_KEYS=                       # comma-separated
GEMINI_API_KEYS=                     # comma-separated
