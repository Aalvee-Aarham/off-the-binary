# Copy to .env. Never commit .env.
# required for approve/reject/mode/chaos endpoints
ADMIN_TOKEN=change-me
# AUTO_GATED | MANUAL
MODE=AUTO_GATED
# simulator ticks per wall-clock second (image default 8; the backend coalesces ticks, demos read better at 1-2)
SIMULATION_SPEED=2
# paused | running. Paused is a normal state: start it from the console (Run) or POST /api/sim/run
SIMULATOR_START_MODE=paused
DECIDE_EVERY_TICKS=4
HORIZON_TICKS=40
EVAL_TICKS=16
COVER_TICKS=32
GATE_MIN_CONFIDENCE=0.6
GATE_MAX_DEPOT_SHARE=0.5
# laya | jev | rules (switchable at runtime: PUT /api/router)
ROUTER_PRIMARY=laya
# english | multilingual | typed-decisions
LAYA_MODEL=typed-decisions
# also ask the non-primary model, for Laya-vs-Jev comparison
ROUTER_SHADOW=1
ROUTER_TIMEOUT_S=30
# OpenRouter key: enables Jev (jev-1.13). Budget-capped per hour.
JEV_API_KEY=
JEV_MAX_CALLS_PER_HOUR=60
# LLM pool: comma-separated keys; bad/expired keys are disabled automatically
# comma-separated
GROQ_API_KEYS=
# comma-separated
GEMINI_API_KEYS=
# optional overrides
# GROQ_MODEL=qwen/qwen3.8-27b
# GEMINI_MODEL=gemini-3.5-flash-lite
