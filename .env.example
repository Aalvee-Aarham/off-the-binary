# Copy to .env. Never commit .env.
# required for approve/reject/mode/chaos endpoints
ADMIN_TOKEN=change-me
# AUTO_GATED | MANUAL
MODE=AUTO_GATED
# simulator ticks per wall-clock second
SIMULATION_SPEED=2
DECIDE_EVERY_TICKS=4
HORIZON_TICKS=40
EVAL_TICKS=16
COVER_TICKS=32
GATE_MIN_CONFIDENCE=0.6
GATE_MAX_DEPOT_SHARE=0.5
# laya | jev | rules (switchable at runtime: PUT /api/router)
ROUTER_PRIMARY=laya
# english | multilingual | typed-decisions
LAYA_MODEL=typed-decisions
# also ask the non-primary model, for Laya-vs-Jev comparison
ROUTER_SHADOW=1
ROUTER_TIMEOUT_S=30
# set to enable Jev (typesafe/jev-1.13)
JEV_API_KEY=
# Phase 6 (not used yet)
# comma-separated
GROQ_API_KEYS=
# comma-separated
GEMINI_API_KEYS=
