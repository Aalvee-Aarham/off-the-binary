# Copy to .env (docker compose reads it automatically).

# Required for any public deployment. Clients send: Authorization: Bearer <key>  (or X-API-Key: <key>)
API_KEY=change-me

# Model used when a request doesn't name one: smollm2-360m | gemma3-1b | smollm2-1.7b
DEFAULT_MODEL=smollm2-360m

# Comma-separated subset of models to load (empty = all from models.toml)
ENABLED_MODELS=

# CPU threads per llama-server (0 = llama.cpp picks the number of physical cores)
LLAMA_THREADS=0

# Response cache for temperature=0 requests
CACHE_SIZE=1024
CACHE_TTL_S=3600

REQUEST_TIMEOUT_S=120
LOG_LEVEL=INFO
